# Required for the default model in this template.
# by default using CLOD_API_KEY with GPT
CLOD_API_KEY=your-clod-api-key

# Optional: override the default model string used by src/simple_agent/graph.py.
SIMPLE_AGENT_MODEL=gpt-4o

# Optional but recommended for tracing.
LANGSMITH_API_KEY=lsv2_...

DB_CONNECTION_STRING="postgresql+psycopg://dev_user:dev_password@localhost:5432/local_agent_db"

# --- RAG Researcher Sources ---

# FRED REST API key (free at https://fred.stlouisfed.org/docs/api/api_key.html)
# Without this, fetch_fred_api falls back to CSV files only.
FRED_API_KEY=your-fred-api-key

# Firecrawl API key (https://firecrawl.dev) — used by fetch_web_page to scrape specific URLs.
# Without this, fetch_web_page falls back to plain httpx + BeautifulSoup.
FIRECRAWL_API_KEY=your-firecrawl-api-key

# Tavily API key (https://tavily.com) — used by search_web_news for macro topic searches.
# Without this, search_web_news will return an error message.
TAVILY_API_KEY=your-tavily-api-key

# Comma-separated list of directories (relative to project root) to watch for new files.
# Supports *.csv, *.pdf, *.txt
WATCH_DIRS=fred_fed_data,research_docs